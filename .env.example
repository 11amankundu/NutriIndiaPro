# Copy to .env (Windows: copy .env.example .env). Never commit .env.
NODE_ENV=development
PORT=3000

# REQUIRED in production: long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Storage (relative paths are fine on Windows)
SQLITE_PATH=./data/nutriindia.db
NOSQL_DIR=./data/nosql

# CORS allow-list (comma separated, no wildcard). Add your frontend / Flutter-web origin here.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limit (per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Outbound calls: timeout, retries (extra attempts after the first), backoff base, circuit breaker
OUTBOUND_TIMEOUT_MS=1500
OUTBOUND_RETRIES=2
OUTBOUND_RETRY_BASE_MS=150
BREAKER_THRESHOLD=3
BREAKER_RESET_MS=10000
# Leave empty to use the built-in mock upstream / mock SOAP service
UPSTREAM_BASE_URL=

# Creates admin@nutriindia.test / demo@nutriindia.test with sample data (set false in real deployments)
SEED_DEMO_DATA=true
# Set to 1 when running behind a reverse proxy / platform load balancer (Render, Railway, nginx)
TRUST_PROXY=
LOG_LEVEL=info
